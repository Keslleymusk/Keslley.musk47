<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>

    <!-- ================================================================ -->
    <!-- Repositório Oficial Keslley Musk47 -->
    <!-- ================================================================ -->

    <addon id="repository.keslley.musk47"
           name="Repositório Keslley Musk47"
           version="1.0.0"
           provider-name="Keslley Musk">

        <extension point="xbmc.addon.repository">
            <info compressed="false">https://raw.githubusercontent.com/Keslleymusk/Keslley.musk47/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Keslleymusk/Keslley.musk47/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Keslleymusk/Keslley.musk47/main/zips/</datadir>
        </extension>

        <extension point="xbmc.addon.metadata">
            <summary>Repositório oficial do addon AlphaTorrent</summary>
            <description>Atualizações automáticas para o addon AlphaTorrent.</description>
            <platform>all</platform>
        </extension>

    </addon>


    <!-- ================================================================ -->
    <!-- Add-on Alpha Torrent listado no repositório -->
    <!-- ================================================================ -->

    <addon id="plugin.video.alphatorrent"
           name="[B][COLOR white]ALPHA[/COLOR] [COLOR lime]TORRENT[/COLOR][/B]"
           version="1.0.1+matrix.1"
           provider-name="[B][COLOR white]keslley.musk47[/COLOR][/B]">

        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>

        <extension point="xbmc.addon.metadata">
            <summary lang="pt_BR">[B][COLOR white]ALPHA TORRENT — Conteúdo direto, rápido e funcional.[/COLOR][/B]</summary>
            <description lang="pt_BR">[COLOR white][B]Todo conteúdo necessário em um só lugar.[/B][/COLOR]</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
                <screenshot>resources/screenshots/home.png</screenshot>
                <screenshot>resources/screenshots/movies.png</screenshot>
                <screenshot>resources/screenshots/series.png</screenshot>
            </assets>
            <news>FORCE_UPDATE_KESLLEY_2025_001</news>
        </extension>

    </addon>


    <!-- ================================================================ -->
    <!-- Add-on BXL listado no repositório -->
    <!-- ================================================================ -->

    <addon id="plugin.video.addon.bxl"
           name="[B][COLOR red]ADDON[/COLOR] [COLOR blue]BXL[/COLOR][/B]"
           version="4.0.0+matrix.1"
           provider-name="Equipe KODISH">

        <extension point="xbmc.python.pluginsource">
            <provides>video</provides>
        </extension>

        <extension point="xbmc.addon.metadata">
            <summary lang="pt_BR">Add-on BXL — conteúdo organizado e funcional.</summary>
            <description lang="pt_BR">Versão listada no repositório Keslley Musk47.</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
            <news>FORCE_UPDATE_BXL_2025_001</news>
        </extension>

    </addon>

</addons>
