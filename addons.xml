    <addon id="repository.keslley.musk47"
           name="[COLOR gold]Repositório keslley.musk47[COLOR red] OFICIAL[/COLOR]"
           version="1.0.0"
           provider-name="[COLOR gold]@keslley.Musk47[/COLOR]">

        <extension point="xbmc.addon.repository">
            <info compressed="false">https://raw.githubusercontent.com/Keslleymusk/Keslley.musk47/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Keslleymusk/Keslley.musk47/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Keslleymusk/Keslley.musk47/main/zips/</datadir>
        </extension>

        <extension point="xbmc.addon.metadata">
            <summary>Repositório oficial de addons diversos.</summary>
            <description>Atualizações automáticas e instalações do addon AlphaTorrent.</description>
            <platform>all</platform>
        </extension>

    </addon>

    <!-- ================================================================ -->
    <!-- Repositório Elementum -->
    <!-- ================================================================ -->
    
    <addon id="repository.elementumorg"
           name="[COLOR grey]ElementumOrg repository[/COLOR]"
           version="0.0.7"
           provider-name="[COLOR white]elgatito[/COLOR]">
           
    <extension point="xbmc.addon.repository">
        <dir>
            <info>http://127.0.0.1:65223/addons.xml</info>
            <checksum>http://127.0.0.1:65223/addons.xml.md5</checksum>
            <datadir>http://127.0.0.1:65223/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>See https://github.com/ElementumOrg/repository.elementumorg/blob/master/LICENSE</license>
        <source>https://github.com/ElementumOrg/repository.elementumorg</source>
        <summary lang="en">GitHub virtual Add-on repository</summary>
        <description lang="en">Customizable repository which acts as a proxy for defined GitHub users' add-ons updates.</description>
        <news>
        </news>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
    

